{
  "name": "jfdi",
  "version": "0.0.1",
  "description": "Just F'ing Do It — a CLI harness around coding-agent CLIs",
  "type": "module",
  "bin": {
    "jfdi": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sync:guidelines": "node scripts/sync-guidelines.mjs",
    "playground": "pnpm build && node scripts/playground.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
