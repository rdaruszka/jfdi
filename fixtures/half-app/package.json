{
  "name": "penny",
  "version": "0.1.0",
  "description": "penny — a tiny expense ledger CLI",
  "type": "module",
  "bin": {
    "penny": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
